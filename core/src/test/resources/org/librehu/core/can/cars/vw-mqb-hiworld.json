 "wheel_keys": {
  "cmd": "0x11",
  "code_byte": 2,
  "state_byte": 3,
  "pressed": [
   1
  ],
  "names": {
   "1": "volume +",
   "2": "volume -",
   "3": "mute",
   "4": "voice",
   "5": "answer / hang up",
   "8": "next",
   "9": "previous",
   "10": "home",
   "11": "mode",
   "12": "car menu",
   "13": "driving settings"
  }
 },
 "messages": {
  "0x11": {
   "name": "State",
   "signals": {
    "status": {
     "start_byte": 0,
     "bits": {
      "ACC": {
       "bit": 0,
       "role": "ignition.acc"
      },
      "lights": {
       "bit": 1,
       "role": "lights.on"
      },
      "reverse": {
       "bit": 2,
       "role": "gear.reverse"
      },
      "handbrake": {
       "bit": 3,
       "role": "handbrake"
      },
      "radar": {
       "bit": 5,
       "role": "radar.shown"
      },
      "mute": 7
     }
    },
    "wheel_key": {
     "start_byte": 2,
     "label": "wheel key",
     "values": {
      "1": "volume +",
      "2": "volume -",
      "3": "mute",
      "4": "voice",
      "5": "answer / hang up",
      "8": "next",
      "9": "previous",
      "10": "home",
      "11": "mode",
      "12": "car menu",
      "13": "driving settings"
     }
    },
    "wheel_key_state": {
     "start_byte": 3,
     "label": "key state"
    },
    "steering": {
     "start_byte": 6,
     "size": 2,
     "endian": "little",
     "signed": true,
     "factor": -1,
     "label": "steering angle",
     "unit": "°",
     "role": "steering.angle"
    }
   }
  },
  "0x12": {
   "name": "Car info",
   "signals": {
    "doors": {
     "start_byte": 2,
     "bits": {
      "front left": {
       "bit": 7,
       "role": "door.front_left"
      },
      "front right": {
       "bit": 6,
       "role": "door.front_right"
      },
      "rear left": {
       "bit": 5,
       "role": "door.rear_left"
      },
      "rear right": {
       "bit": 4,
       "role": "door.rear_right"
      },
      "trunk": {
       "bit": 3,
       "role": "door.trunk"
      },
      "hood": {
       "bit": 2,
       "role": "door.hood"
      }
     }
    },
    "consumption": {
     "start_byte": 3,
     "label": "instant consumption",
     "role": "fuel.instant"
    },
    "warnings": {
     "start_byte": 6,
     "bits": {
      "low battery": {
       "bit": 7,
       "role": "battery.warning"
      },
      "low oil": {
       "bit": 6,
       "role": "engine.oil_warning"
      },
      "seat belt": {
       "bit": 5,
       "role": "seatbelt.warning"
      },
      "washer fluid": {
       "bit": 4,
       "role": "washer.warning"
      }
     }
    },
    "fuel": {
     "start_byte": 7,
     "label": "fuel left"
    },
    "battery": {
     "start_byte": 8,
     "unit": "V",
     "label": "battery (whole volts)",
     "role": "battery.voltage"
    }
   }
  },
  "0x19": {
   "name": "Engine",
   "signals": {
    "oil_temp": {
     "start_byte": 6,
     "offset": -40,
     "unit": "°C",
     "label": "oil temperature",
     "role": "engine.oil_temp"
    },
    "coolant": {
     "start_byte": 7,
     "offset": -40,
     "unit": "°C",
     "label": "coolant temperature",
     "role": "engine.coolant_temp"
    },
    "rpm": {
     "start_byte": 8,
     "size": 2,
     "unit": "rpm",
     "label": "engine speed",
     "role": "engine.rpm"
    }
   }
  },
  "0x36": {
   "name": "Turn signals",
   "signals": {
    "turn": {
     "start_byte": 1,
     "bits": {
      "right": {
       "bit": 0,
       "role": "turn.right"
      },
      "left": {
       "bit": 1,
       "role": "turn.left"
      }
     }
    }
   }
  },
  "0x41": {
   "name": "Parking radar",
   "signals": {
    "rear_L": {
     "start_byte": 0,
     "label": "rear L (raw, /15)"
    },
    "rear_LM": {
     "start_byte": 1,
     "label": "rear LM (raw, /15)"
    },
    "rear_RM": {
     "start_byte": 2,
     "label": "rear RM (raw, /15)"
    },
    "rear_R": {
     "start_byte": 3,
     "label": "rear R (raw, /15)"
    },
    "front_L": {
     "start_byte": 4,
     "label": "front L (raw, /15)"
    },
    "front_LM": {
     "start_byte": 5,
     "label": "front LM (raw, /15)"
    },
    "front_RM": {
     "start_byte": 6,
     "label": "front RM (raw, /15)"
    },
    "front_R": {
     "start_byte": 7,
     "label": "front R (raw, /15)"
    }
   }
  },
  "0xF0": {
   "name": "Box version",
   "signals": {
    "version": {
     "start_byte": 0,
     "ascii": true,
     "label": "version",
     "role": "box.version"
    }
   }
  }
 },
 "examples": [
  {
   "cmd": "0x19",
   "data": "00 00 00 00 00 00 82 7D 03 20",
   "expect": {
    "engine.oil_temp": 90,
    "engine.coolant_temp": 85,
    "engine.rpm": 800
   }
  },
  {
   "cmd": "0x12",
   "data": "00 00 80 00 00 00 20 00 0C",
   "expect": {
    "door.front_left": true,
    "door.trunk": false,
    "seatbelt.warning": true,
    "battery.voltage": 12
   }
  },
  {
   "cmd": "0x11",
   "data": "00 00 00 00 00 00 00 01",
   "expect": {
    "steering.angle": -256
   }
  }
 ]
}

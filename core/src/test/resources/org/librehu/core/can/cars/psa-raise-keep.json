 "id": "psa-raise-keep",
 "name": "Peugeot, Citroën (Raise PSA, original screen kept)",
 "description": "Raise (RZC) box for PSA keeping the original small screen (RePsaProtocol_KeepOriginalDisplay). Car Info's decoder (com.can.activity 1.0.3991) for these boxes; cars and car types (0xA7) from its managers and buildCarTypePacket. FD framing, 19200 bit/s, no acknowledgement; car type 0xA7 [05, trim, 00] every second. Not tried on a car yet.",
 "box": "raise-fd",
 "baud": 19200,
 "link": {
  "ack": false,
  "send": [
   {
    "name": "connect",
    "cmd": "0x81",
    "data": "01",
    "first_ms": 500,
    "every_ms": 0
   },
   {
    "name": "car type",
    "cmd": "0xA7",
    "data": "",
    "first_ms": 1000,
    "every_ms": 1000
   }
  ]
 },

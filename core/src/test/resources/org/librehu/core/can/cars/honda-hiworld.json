 "wheel_keys": {
  "cmd": "0x11",
  "code_byte": 2,
  "state_byte": 3,
  "pressed": [
   1
  ],
  "names": {
   "1": "volume +",
   "2": "volume -",
   "4": "voice",
   "5": "answer",
   "6": "hang up / back",
   "8": "previous",
   "9": "next",
   "10": "home / mode",
   "11": "mode",
   "12": "mode",
   "13": "previous",
   "14": "next",
   "15": "play / pause",
   "16": "back",
   "34": "home",
   "35": "FM",
   "36": "AM",
   "37": "music",
   "38": "EQ",
   "39": "EQ"
  }
 },
 "messages": {
  "0x11": {
   "name": "State",
   "signals": {
    "status": {
     "start_byte": 0,
     "bits": {
      "lights": {
       "bit": 1,
       "role": "lights.on"
      },
      "reverse": {
       "bit": 2,
       "role": "gear.reverse"
      },
      "handbrake": {
       "bit": 3,
       "role": "handbrake"
      }
     }
    },
    "speed": {
     "start_byte": 1,
     "unit": "km/h",
     "label": "speed",
     "role": "vehicle.speed"
    },
    "wheel_key": {
     "start_byte": 2,
     "label": "wheel key",
     "values": {
      "1": "volume +",
      "2": "volume -",
      "4": "voice",
      "5": "answer",
      "6": "hang up / back",
      "8": "previous",
      "9": "next",
      "10": "home / mode",
      "11": "mode",
      "12": "mode",
      "13": "previous",
      "14": "next",
      "15": "play / pause",
      "16": "back",
      "34": "home",
      "35": "FM",
      "36": "AM",
      "37": "music",
      "38": "EQ",
      "39": "EQ"
     }
    },
    "wheel_key_state": {
     "start_byte": 3,
     "label": "key state"
    },
    "steering": {
     "start_byte": 6,
     "size": 2,
     "sign_magnitude": true,
     "factor": -0.103846,
     "unit": "°",
     "label": "steering angle",
     "role": "steering.angle"
    }
   }
  },
  "0x12": {
   "name": "Doors",
   "signals": {
    "doors": {
     "start_byte": 2,
     "bits": {
      "front left": {
       "bit": 7,
       "role": "door.front_left"
      },
      "front right": {
       "bit": 6,
       "role": "door.front_right"
      },
      "rear left": {
       "bit": 5,
       "role": "door.rear_left"
      },
      "rear right": {
       "bit": 4,
       "role": "door.rear_right"
      },
      "trunk": {
       "bit": 3,
       "role": "door.trunk"
      },
      "hood": {
       "bit": 2,
       "role": "door.hood"
      }
     }
    }
   }
  },
  "0x41": {
   "name": "Parking radar",
   "signals": {
    "rear_left": {
     "start_byte": 0,
     "label": "rear L (raw)"
    },
    "rear_left_mid": {
     "start_byte": 1,
     "label": "rear LM (raw)"
    },
    "rear_right_mid": {
     "start_byte": 2,
     "label": "rear RM (raw)"
    },
    "rear_right": {
     "start_byte": 3,
     "label": "rear R (raw)"
    },
    "front_left": {
     "start_byte": 4,
     "label": "front L (raw)"
    },
    "front_left_mid": {
     "start_byte": 5,
     "label": "front LM (raw)"
    },
    "front_right": {
     "start_byte": 6,
     "label": "front R (raw)"
    },
    "front_right_mid": {
     "start_byte": 7,
     "label": "front RM (raw)"
    },
    "radar_mode": {
     "start_byte": 10,
     "label": "rear radar on"
    }
   }
  },
  "0xF0": {
   "name": "Box version",
   "signals": {
    "version": {
     "start_byte": 0,
     "ascii": true,
     "label": "version",
     "role": "box.version"
    }
   }
  }
 },

    "handbrake": true,
    "vehicle.speed": 50,
    "steering.angle": 31.15
   }
  },
  {
   "cmd": "0x11",
   "data": "00 00 00 00 00 00 01 2C",
   "expect": {
    "handbrake": false,
    "steering.angle": -31.15
   }
  }
 ]

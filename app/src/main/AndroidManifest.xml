<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Clients declare <uses-permission android:name="org.librehu.permission.HEADUNIT" />.
         TODO: move to signature|privileged once the LibreHU apps share a signing key. -->
    <permission
        android:name="org.librehu.permission.HEADUNIT"
        android:description="@string/permission_description"
        android:label="@string/permission_label"
        android:protectionLevel="normal" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Volume panel over the apps (overlay/VolumeOverlay), granted by the user or with
         adb shell appops set org.librehu.service SYSTEM_ALERT_WINDOW allow -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Clock from the MCU RTC: granted only to privileged / system installs. -->
    <uses-permission
        android:name="android.permission.SET_TIME"
        tools:ignore="ProtectedPermissions" />

    <!-- Bluetooth (bt/BluetoothModule): car profiles, pairing answers, phone book. Android 9 uses the legacy
         permissions; BLUETOOTH_PRIVILEGED needs the privileged install (install/privapp-permissions-org.librehu.service.xml).
         READ_CONTACTS, READ_CALL_LOG and ACCESS_FINE_LOCATION (discovery) are runtime permissions: grant them from the
         app or with `pm grant` (docs/bluetooth.md). -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_PRIVILEGED"
        tools:ignore="ProtectedPermissions" />
    <!-- Also the GPS test and the clock from GPS (time/TimeController). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- Display (display/DisplayController): system dark mode and brightness following the headlights. -->
    <uses-permission
        android:name="android.permission.MODIFY_DAY_NIGHT_MODE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ELM327 OBD-II adapters on USB (obd/ObdManager). -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <queries>
        <package android:name="com.jancar.services" />
        <package android:name="com.jancar.btservice" />
        <package android:name="com.android.bluetooth" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Touch panel calibration (touch/TouchCalibrationActivity): full screen, opened from the Touch panel tab. -->
        <activity
            android:name=".touch.TouchCalibrationActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:screenOrientation="locked"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <service
            android:name=".LibreHuService"
            android:directBootAware="true"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="org.librehu.permission.HEADUNIT">
            <intent-filter>
                <action android:name="org.librehu.service.BIND" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Head unit hardware service (MCU link, audio processor)" />
        </service>

        <!-- OBD-II values (ELM327) for LibreHU Launcher's widget slots or any home screen. -->
        <receiver
            android:name=".obd.ObdWidget"
            android:exported="true"
            android:label="@string/obd_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/obd_widget_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

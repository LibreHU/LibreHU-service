<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The car's description and the head unit's radio names and MAC addresses (car/VehicleProvider): the apps
         signed with the LibreHU key only (launcher, Open Headunit LibreHU, CarPlay LibreHU). -->
    <permission
        android:name="org.librehu.permission.VEHICLE"
        android:label="@string/permission_vehicle_label"
        android:description="@string/permission_vehicle_description"
        android:protectionLevel="signature" />
    <!-- Held to send the vehicle broadcasts (VEHICLE_STATE, ACC, REVERSE, OBD) under VEHICLE: only the apps signed
         with the LibreHU key receive them, and the LibreHU apps take them from a holder of VEHICLE only. -->
    <uses-permission android:name="org.librehu.permission.VEHICLE" />

    <!-- Key claims of LibreHU Touches (CLAIM_KEYS): apps signed with the LibreHU key only. -->
    <permission
        android:name="org.librehu.permission.HEADUNIT"
        android:description="@string/permission_description"
        android:label="@string/permission_label"
        android:protectionLevel="signature" />

    <!-- Root asked for every LibreHU app at once (LibreHU Launcher): requests and answers between apps signed with
         the LibreHU key only. Defined by every LibreHU app, so that it exists whatever the install order. -->
    <permission
        android:name="org.librehu.permission.ROOT_REQUEST"
        android:protectionLevel="signature" />
    <uses-permission android:name="org.librehu.permission.ROOT_REQUEST" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Volume panel over the apps (overlay/VolumeOverlay), granted by the user or with
         adb shell appops set org.librehu.service SYSTEM_ALERT_WINDOW allow -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Built-in rear view (Camera2). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Open Headunit LibreHU (org.librehu.headunit): its automation receiver for the LibreHU key, configuration
         included (signature permission it declares). -->
    <uses-permission android:name="org.librehu.headunit.permission.CONFIGURE" />
    <!-- Day / night from the headlights to CarPlay (xcertplay LibreHU, signature permission it declares). -->
    <uses-permission android:name="org.librehu.carplay.permission.CONFIGURE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Clock from the MCU RTC: granted only to privileged / system installs. -->
    <uses-permission
        android:name="android.permission.SET_TIME"
        tools:ignore="ProtectedPermissions" />

    <!-- Bluetooth (bt/BluetoothModule): car profiles, pairing answers, phone book. Android 9 uses the legacy
         permissions; BLUETOOTH_PRIVILEGED needs the privileged install (install/privapp-permissions-org.librehu.service.xml).
         READ_CONTACTS, READ_CALL_LOG and ACCESS_FINE_LOCATION (discovery) are runtime permissions: grant them from the
         app or with `pm grant` (docs/bluetooth.md). -->
    <!-- LibreHU bridge: the phone app connects over Wi-Fi (bridge/BridgeServer, port 47800, encrypted). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wired networks of the Network page (net/EthernetIp, net/UsbNet): ConnectivityManager.getAllNetworks. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Settings pages of the other LibreHU apps for the phone app (their ".bridge" providers, same signing key). -->
    <permission
        android:name="org.librehu.permission.BRIDGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="org.librehu.permission.BRIDGE" />
    <!-- Files of the phone app (bridge/BridgeTools): internal storage and USB keys. Runtime permissions on Android 9,
         granted with `pm grant` as root when the phone first opens the files. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_PRIVILEGED"
        tools:ignore="ProtectedPermissions" />
    <!-- Also the GPS test and the clock from GPS (time/TimeController). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- GPS reset (delete_aiding_data, time / XTRA injection). -->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Level meter of the audio diagnostics (Visualizer on the output mix). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- Display (display/DisplayController): system dark mode and brightness following the headlights. -->
    <uses-permission
        android:name="android.permission.MODIFY_DAY_NIGHT_MODE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ELM327 OBD-II adapters on USB (obd/ObdManager). -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- Hotspot name of the car (car/CarName): read the hotspot settings; the change itself goes through root. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <queries>
        <!-- Projection apps (Android 11+ package visibility). -->
        <package android:name="org.librehu.carplay" />
        <package android:name="com.shilapi.xcertplay" />
        <package android:name="com.jancar.services" />
        <package android:name="com.jancar.btservice" />
        <package android:name="com.android.bluetooth" />
        <!-- Root managers (root/RootShell). -->
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="io.github.vvb2060.magisk" />
        <package android:name="io.github.huskydg.magisk" />
        <package android:name="me.bmax.apatch" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
        <!-- Rear camera apps (car/ReverseCamera) and the list of apps to choose from. -->
        <package android:name="com.jancar.hd2cam" />
        <package android:name="com.baony.avm360" />
        <!-- Android Auto receivers (projection/AndroidAuto). -->
        <package android:name="org.librehu.headunit" />
        <package android:name="com.andrerinas.headunitrevived" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Settings pages of the LibreHU apps for the phone app (bridge/BridgePages). -->
        <provider android:authorities="org.librehu.launcher.bridge" />
        <provider android:authorities="org.librehu.btnremap.bridge" />
        <provider android:authorities="org.librehu.ota.bridge" />
        <provider android:authorities="org.librehu.disc.bridge" />
        <provider android:authorities="org.librehu.fm.bridge" />
        <provider android:authorities="org.librehu.dialer.bridge" />
        <provider android:authorities="org.librehu.widgets.bridge" />
        <provider android:authorities="org.librehu.easysource.bridge" />
        <provider android:authorities="org.librehu.helper.bridge" />
        <provider android:authorities="com.llsl.viper4android.bridge" />
        <provider android:authorities="org.librehu.carplay.bridge" />
    </queries>

    <!-- persistent: honoured for a system app only (LineageOS ROM, /system/app): persistent priority, restarted at
         once, no Force stop button; a user app gets the root guard instead (power/Keepalive). -->
    <application
        android:allowBackup="false"
        android:persistent="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">
        <!-- Single-colour icon: LibreHU Launcher draws it in the colours of its theme. -->
        <meta-data
            android:name="org.librehu.themed_icon"
            android:resource="@drawable/ic_launcher_mono" />


        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LibreHU's entries in Android's Settings (systemsettings/SystemSettings): Settings shows those of system apps
             only (LineageOS ROM), in the page named by com.android.settings.category. Each opens its page of the
             service (org.librehu.service.TAB). No label or icon of their own: the task keeps the app's in recents.
             Live summaries from SummaryProvider (summary_uri: content://<authority>/<method>), fixed on the home
             page (Android 9 reads live ones there for its own entries only). -->
        <activity-alias
            android:name=".systemsettings.HomeEntry"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/sys_settings_home" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/sys_settings_home_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_launcher_mono" />
            <!-- Colour of the round background Settings draws behind the icon on its home page. -->
            <meta-data
                android:name="com.android.settings.bg.hint"
                android:resource="@color/sys_settings_icon_background" />
            <meta-data
                android:name="org.librehu.service.TAB"
                android:value="HOME" />
        </activity-alias>

        <activity-alias
            android:name=".systemsettings.DisplayEntry"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/sys_settings_display" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://org.librehu.service.systemsettings/display" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_launcher_mono" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="org.librehu.service.TAB"
                android:value="DISPLAY" />
        </activity-alias>

        <activity-alias
            android:name=".systemsettings.SoundEntry"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/sys_settings_sound" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/sys_settings_sound_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_launcher_mono" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="org.librehu.service.TAB"
                android:value="AUDIO" />
        </activity-alias>

        <activity-alias
            android:name=".systemsettings.BluetoothEntry"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.connect" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/sys_settings_bluetooth" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://org.librehu.service.systemsettings/bluetooth" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_launcher_mono" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="org.librehu.service.TAB"
                android:value="BLUETOOTH" />
        </activity-alias>

        <!-- Settings > Connected devices > Connection preferences > Received files opens the transfer history of the
             Bluetooth app (com.android.bluetooth.action.TransferHistory). This ROM's Bluetooth app (car profiles) has
             no file transfer (OPP), so Settings crashed (ActivityNotFoundException): the service's Bluetooth page
             answers instead. -->
        <activity-alias
            android:name=".systemsettings.TransferHistoryEntry"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="com.android.bluetooth.action.TransferHistory" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="org.librehu.service.TAB"
                android:value="BLUETOOTH" />
        </activity-alias>

        <activity-alias
            android:name=".systemsettings.AndroidAutoEntry"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.connect" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/sys_settings_android_auto" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://org.librehu.service.systemsettings/android_auto" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_launcher_mono" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="org.librehu.service.TAB"
                android:value="ANDROID_AUTO" />
        </activity-alias>

        <activity-alias
            android:name=".systemsettings.SystemEntry"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/sys_settings_system" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://org.librehu.service.systemsettings/system" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_launcher_mono" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="org.librehu.service.TAB"
                android:value="SYSTEM" />
        </activity-alias>

        <!-- Safe shutdown message (power/SafeShutdownActivity). -->
        <activity
            android:name=".power.SafeShutdownActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- Touch panel calibration (touch/TouchCalibrationActivity): full screen, opened from the Touch panel tab. -->
        <activity
            android:name=".touch.TouchCalibrationActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:screenOrientation="locked"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- CVBS IN 1 / 2 full screen (car/CvbsActivity), also an entry of the app drawer ("CVBS IN"). -->
        <activity
            android:name=".car.CvbsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:icon="@drawable/ic_cvbs_launcher"
            android:label="@string/cvbs_app_name"
            android:launchMode="singleTask"
            android:taskAffinity="org.librehu.service.cvbs"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Single-colour icon of this entry for LibreHU Launcher. -->
            <meta-data
                android:name="org.librehu.themed_icon"
                android:resource="@drawable/ic_cvbs" />
        </activity>

        <service
            android:name=".LibreHuService"
            android:directBootAware="true"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <!-- No android:permission: callers are checked by ServiceAccess (LibreHU apps allowed, others asked). -->
            <intent-filter>
                <action android:name="org.librehu.service.BIND" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Head unit hardware service (MCU link, audio processor)" />
        </service>

        <receiver
            android:name=".AccessReceiver"
            android:exported="false" />

        <!-- Alarm of the standby suspend test (power/Standby.testSuspend). -->
        <receiver
            android:name=".power.StandbyTestReceiver"
            android:exported="false" />

        <!-- Allow / refuse of a phone pairing in Bluetooth (bridge/BridgeNotify). -->
        <receiver
            android:name=".bridge.BridgeAnswerReceiver"
            android:exported="false" />

        <!-- Stop of the screen shared with a phone (screen/ScreenShare). -->
        <receiver
            android:name=".screen.ScreenStopReceiver"
            android:exported="false" />

        <!-- Front panel LEDs blinking on notifications (car/FrontLed). -->
        <service
            android:name=".car.NotificationBlinkService"
            android:exported="true"
            android:label="@string/led_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Buttons another app (LibreHU BtnRemap) handles: the service leaves them to it. -->
        <!-- Packs of car profiles by make, installed by LibreHU Apps (can/CarPackReceiver). -->
        <receiver
            android:name=".can.CarPackReceiver"
            android:exported="true"
            android:permission="org.librehu.permission.HEADUNIT">
            <intent-filter>
                <action android:name="org.librehu.service.QUERY_CAR_PACKS" />
                <action android:name="org.librehu.service.INSTALL_CAR_PACK" />
                <action android:name="org.librehu.service.REMOVE_CAR_PACK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".can.KeyClaimReceiver"
            android:exported="true"
            android:permission="org.librehu.permission.HEADUNIT">
            <intent-filter>
                <action android:name="org.librehu.service.CLAIM_KEYS" />
            </intent-filter>
        </receiver>

        <!-- Phone app pairing from LibreHU Launcher's first start (QR code, Bluetooth requests); call() only, the
             permission is checked in the provider (Android does not for call()). -->
        <provider
            android:name=".bridge.BridgePairProvider"
            android:authorities="org.librehu.service.bridgepair"
            android:exported="true"
            android:permission="org.librehu.permission.BRIDGE" />

        <!-- Diagnostics for LibreHU Helper's report and adb (diag/DiagnosticsProvider): read only, callers as for the
             API (LibreHU apps, system, shell, apps the user allowed). -->
        <provider
            android:name=".diag.DiagnosticsProvider"
            android:authorities="org.librehu.service.diagnostics"
            android:directBootAware="true"
            android:exported="true" />

        <!-- Live summaries of LibreHU's entries in Android's Settings (systemsettings/SummaryProvider): call() only,
             answered to Settings (system uid), root and the app; Android checks no permission for call(). -->
        <provider
            android:name=".systemsettings.SummaryProvider"
            android:authorities="org.librehu.service.systemsettings"
            android:exported="true" />

        <!-- Live rear camera stream drawn into LibreHU Launcher's own view (apps with the LibreHU key only). -->
        <provider
            android:name=".car.VehicleProvider"
            android:authorities="org.librehu.service.vehicle"
            android:exported="true"
            android:readPermission="org.librehu.permission.VEHICLE"
            android:writePermission="org.librehu.permission.VEHICLE" />

        <!-- The phone's Internet over the USB cable with wired Android Auto (net/cable/CableInternet): the VPN whose
             packets go to the phone's relay through adb. -->
        <service
            android:name=".net.cable.CableVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".car.RearPreviewService"
            android:exported="true">
            <intent-filter>
                <action android:name="org.librehu.service.REAR_PREVIEW" />
            </intent-filter>
        </service>

        <!-- Rear view widget: live picture, opens / closes LibreHU's rear view. -->
        <receiver
            android:name=".car.ReverseWidget"
            android:exported="true"
            android:label="@string/reverse_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!-- LibreHU Launcher's home screen shown or left: live picture in the widget. -->
            <intent-filter>
                <action android:name="org.librehu.action.HOME_VISIBLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/reverse_widget_info" />
        </receiver>

        <!-- Android Auto and CarPlay: session, open, disconnect (projection/ProjectionWidgets). -->
        <!-- Phone widget: iPhone (CarPlay app) or Bluetooth phone details (phone/PhoneWidget). -->
        <receiver
            android:name=".phone.PhoneWidget"
            android:exported="true"
            android:label="@string/phone_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/phone_widget_info" />
        </receiver>
        <receiver
            android:name=".projection.AndroidAutoWidget"
            android:exported="true"
            android:label="@string/android_auto_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/android_auto_widget_info" />
        </receiver>
        <receiver
            android:name=".projection.CarPlayWidget"
            android:exported="true"
            android:label="@string/cp_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/carplay_widget_info" />
        </receiver>

        <!-- OBD-II values (ELM327) for LibreHU Launcher's widget slots or any home screen. -->
        <receiver
            android:name=".obd.ObdWidget"
            android:exported="true"
            android:label="@string/obd_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/obd_widget_info" />
        </receiver>

        <!-- OBD-II dashboards (analog dials / digital cluster), Android Auto style. -->
        <receiver
            android:name=".obd.ObdDashAnalogWidget"
            android:exported="true"
            android:label="@string/obd_dash_analog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/obd_dash_analog_info" />
        </receiver>
        <receiver
            android:name=".obd.ObdDashDigitalWidget"
            android:exported="true"
            android:label="@string/obd_dash_digital">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/obd_dash_digital_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- LibreHU Launcher's first start: root asked for every LibreHU app at once (RootRequestReceiver). -->
        <receiver
            android:name=".RootRequestReceiver"
            android:exported="true"
            android:permission="org.librehu.permission.ROOT_REQUEST">
            <intent-filter>
                <action android:name="org.librehu.action.REQUEST_ROOT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

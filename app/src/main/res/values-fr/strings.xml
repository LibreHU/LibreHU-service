    <string name="standby_acc_delay">Délai avant coupure (démarrage moteur)</string>
    <string name="standby_acc_delay_hint">Le + après-contact chute pendant le démarrage du moteur : une coupure plus courte que ce délai garde l\'écran, le son et l\'ampli. La MCU attend elle-même 1 s et coupe le SoC 15 s après le contact : 10 s au plus.</string>
    <string name="standby_mode_off">Écran éteint seulement</string>
    <string name="standby_mode_sleep">Veille</string>
    <string name="standby_mode_shutdown">Extinction</string>
    <string name="standby_mode_off_hint">Comme avant : écran, son et ampli coupés ; la MCU coupe le SoC d\'elle-même (démarrage à froid au prochain contact, sauf si elle garde une durée de veille réglée par Jancar).</string>
    <string name="standby_mode_sleep_hint">Médias en pause, écran d\'accueil, données écrites, minuterie de veille de la MCU, Android en veille : démarrage instantané au retour du contact. Pas encore testé sur l\'UJC201 : essayer d\'abord avec une durée courte.</string>
    <string name="standby_mode_shutdown_hint">Médias en pause, données écrites, minuterie de la MCU à 0 : la MCU coupe le SoC (démarrage à froid au prochain contact).</string>
    <string name="standby_max">Extinction après</string>
